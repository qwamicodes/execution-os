# =============================================================================
# Execution OS - Unified Docker Environment
# =============================================================================
# Use this single file for BOTH:
# 1) infrastructure/docker/infra.compose.yml
# 2) infrastructure/docker/app.compose.yml
#
# Copy to .env.staging or .env.production and fill values.
# =============================================================================

# --- Runtime mode ---
NODE_ENV=production

# --- Infrastructure ports (host) ---
POSTGRES_PORT=8910
REDIS_PORT=8911

# --- App ports (host) ---
API_PORT=8901
AUTH_PORT=8902
DASHBOARD_PORT=8903

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=execution_os

# --- Redis ---
REDIS_PASSWORD=change_me

# --- Internal service URLs used by API/migrate containers ---
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@eos-postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://default:${REDIS_PASSWORD}@eos-redis:6379

# --- Browser-facing app URLs (also used at frontend build time) ---
VITE_API_URL=http://localhost:8901
VITE_AUTH_URL=http://localhost:8902
VITE_DASHBOARD_URL=http://localhost:8903

# --- API core ---
PORT=8901
CORS_ORIGIN=http://localhost:8903,http://localhost:8902
SESSION_SECRET=change_me_to_a_random_64_char_string
AUTH_APP_URL=http://localhost:8902

# --- Email / OTP ---
PURPLE_BOX_API_KEY=
EMAIL_FROM=noreply@executionos.com
BRRR_WEBHOOK_URL=
BRRR_WEBHOOK_SECRET=
BRRR_DEFAULT_SOUND=brrr

# --- Logging / observability ---
SERVICE_NAME=execution-os-api
SERVICE_VERSION=0.0.0
COMMIT_SHA=unknown
ENVIRONMENT=production
LOG_LEVEL=info
LOG_SLOW_REQUEST_THRESHOLD_MS=500
LOG_SUCCESS_SAMPLE_RATE=0.1

# --- AI routing ---
AI_AUTO_CLASSIFY_ON_TASK_CREATE=true
AI_ROUTING_MODE=round_robin
AI_FIXED_PROVIDER=
AI_PROVIDER_ORDER=anthropic,openai,ollama
AI_TIMEOUT_MS=45000
AI_TASK_RECOMMENDATION_TTL_SECONDS=300
AI_PRIORITY_RECALC_INTERVAL_MS=900000
AI_CLASSIFICATION_RETRY_ATTEMPTS=3
AI_CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.8

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_NANO_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Slack integration ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_SCOPES=channels:read,channels:history,groups:read,groups:history,reactions:read,users:read,chat:write
SLACK_SIGNING_SECRET=

# --- Gmail integration ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email

# --- Integrations / realtime tuning ---
INTEGRATION_IMPORT_DEDUP_TTL_SECONDS=7776000
GIT_WEBHOOK_SECRET=
REALTIME_HEARTBEAT_MS=25000
VOICE_TRANSCRIPTION_JOB_TTL_SECONDS=86400
