# =============================================================================
# Execution OS - Environment Configuration
# =============================================================================
# Copy this file to .env.staging or .env.production and fill in real values.
# NEVER commit actual credentials to version control.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=execution_os
POSTGRES_PORT=8910

# --- Redis ---
REDIS_PORT=8911
REDIS_PASSWORD=change_me

# --- Application ---
# Port sequence: web=8900, api=8901, auth=8902, dashboard=8903, desktop=8904
# Infrastructure: postgres=8910, redis=8911
NODE_ENV=production
WEB_PORT=8900
API_PORT=8901
AUTH_PORT=8902
DASHBOARD_PORT=8903

# --- Database URL (used by API + migrate services) ---
# In Docker, containers talk on internal ports (5432/6379) via service names
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@eos-postgres:5432/${POSTGRES_DB}

# --- Redis URL ---
REDIS_URL=redis://eos-redis:6379

# --- CORS ---
CORS_ORIGIN=http://localhost:8900

# --- Auth ---
SESSION_SECRET=change_me_to_a_random_64_char_string

# --- Email (thepurplebox.io) ---
PURPLE_BOX_API_KEY=your_api_key_here
EMAIL_FROM=noreply@executionos.com
AUTH_APP_URL=http://localhost:8902

# --- Logging ---
SERVICE_NAME=execution-os-api
SERVICE_VERSION=0.0.0
COMMIT_SHA=unknown
LOG_LEVEL=info
LOG_SLOW_REQUEST_THRESHOLD_MS=500
LOG_SUCCESS_SAMPLE_RATE=0.1
