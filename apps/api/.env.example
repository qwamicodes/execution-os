# database setup
DATABASE_URL=<db_url>

# cors origin
CORS_ORIGIN=<cors_origin>

# auth setup
AUTH_APP_URL=<auth_app_url>

# redis setup
REDIS_URL=<redis_url>

# email setup
PURPLE_BOX_API_KEY=<purple_box_api_key>
EMAIL_FROM=<email_from_address>

# observability and logs
SERVICE_NAME=<service_name>
SERVICE_VERSION=<service_version>
COMMIT_SHA=<commit_sha>
ENVIRONMENT=<environment>
LOG_LEVEL=info
LOG_SLOW_REQUEST_THRESHOLD_MS=500
LOG_SUCCESS_SAMPLE_RATE=0.1

# AI providers + routing
AI_AUTO_CLASSIFY_ON_TASK_CREATE=true
AI_ROUTING_MODE=round_robin
AI_FIXED_PROVIDER=
AI_PROVIDER_ORDER=anthropic,openai,ollama
AI_TIMEOUT_MS=45000
AI_TASK_RECOMMENDATION_TTL_SECONDS=300
AI_PRIORITY_RECALC_INTERVAL_MS=900000
AI_CLASSIFICATION_RETRY_ATTEMPTS=3
AI_CLASSIFICATION_LOW_CONFIDENCE_THRESHOLD=0.8

# Claude (Anthropic)
ANTHROPIC_API_KEY=<anthropic_api_key>
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI
OPENAI_API_KEY=<openai_api_key>
OPENAI_MODEL=gpt-5-mini
OPENAI_NANO_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Slack integration
SLACK_CLIENT_ID=<slack_client_id>
SLACK_CLIENT_SECRET=<slack_client_secret>
SLACK_REDIRECT_URI=<slack_redirect_uri>
SLACK_SCOPES=channels:read,channels:history,groups:read,groups:history,reactions:read,users:read,chat:write
SLACK_SIGNING_SECRET=<slack_signing_secret>

# Gmail integration
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
GOOGLE_REDIRECT_URI=<google_redirect_uri>
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email

# Import idempotency
INTEGRATION_IMPORT_DEDUP_TTL_SECONDS=7776000

# Git webhook verification (optional but recommended)
GIT_WEBHOOK_SECRET=<git_webhook_secret>

# Realtime + voice integration tuning
REALTIME_HEARTBEAT_MS=25000
VOICE_TRANSCRIPTION_JOB_TTL_SECONDS=86400
