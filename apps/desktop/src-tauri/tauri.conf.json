{
	"$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
	"productName": "execution-os-desktop",
	"version": "0.1.0",
	"identifier": "com.execution-os.desktop",
	"build": {
		"frontendDist": "../../dashboard/dist",
		"devUrl": "http://localhost:8903",
		"beforeDevCommand": "cd ../dashboard && bun run dev",
		"beforeBuildCommand": "cd ../dashboard && bun run build"
	},
	"app": {
		"title": "Execution OS",
		"windows": [
			{
				"title": "Execution OS",
				"width": 1024,
				"height": 768
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
